if __name__ == "__main__":
    print("=" * 70)
    print("VALIDATION: Power for two-sample t-test (exact, non-central t)")
    print("=" * 70)
    print("Reference (G*Power / Cohen): d=0.5, n=64/group, alpha=0.05 -> power ~0.80")
    print()

    for n in (20, 30, 50, 64, 100):
        r = PowerAnalysis.two_sample_t_test(effect_size=0.5, n_per_group=n)
        print(f"  d=0.5, n={n:>3}/group:  power = {r.power}")

    print()
    print("Reference check: d=0.5 should need n≈64 for 80% power")
    n_needed = PowerAnalysis.required_sample_size(effect_size=0.5, target_power=0.80)
    print(f"  required_sample_size(d=0.5, power=0.80) = {n_needed} per group")

    print()
    print("Large effect d=0.8 (Cohen 'large'): reference n≈26 for 80% power")
    n_needed_large = PowerAnalysis.required_sample_size(effect_size=0.8, target_power=0.80)
    print(f"  required_sample_size(d=0.8, power=0.80) = {n_needed_large} per group")

    print()
    print("Small effect d=0.2 (Cohen 'small'): reference n≈394 for 80% power")
    n_needed_small = PowerAnalysis.required_sample_size(effect_size=0.2, target_power=0.80)
    print(f"  required_sample_size(d=0.2, power=0.80) = {n_needed_small} per group")
